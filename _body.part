    <div class="credit" data-dept="Producer"><span class="yr">2025</span><span class="ti">June 31<sup>st</sup></span><span class="ro">Producer</span><span class="di">dir. Ling Shi</span></div>
    <div class="credit" data-dept="Producer"><span class="yr">2024</span><span class="ti">18th First Film Festival — <em style="display:inline;font-family:inherit;font-size:inherit;text-transform:none;letter-spacing:0;color:inherit">“Training Camp”</em></span><span class="ro">Production assistant</span><span class="di">XiNing, China</span></div>

