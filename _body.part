<section id="contact" class="wrap contact">
  <div class="marker" style="display:flex;align-items:center;gap:1rem;padding-bottom:.9rem;border-bottom:1px solid var(--line-soft)">
    <span class="no" style="font-family:var(--f-mono);font-size:.68rem;letter-spacing:.2em;color:var(--lamp)">08</span>
    <span class="nm" style="font-family:var(--f-mono);font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)">Contact</span>
  </div>
  <h2 class="section-title" style="margin-bottom:2rem">Bring me a script,<br>or a room to light.</h2>

  <p style="margin:0"><a class="big-link" data-link="email" data-fill="email" href="#" style="font-size:clamp(1.05rem,2.2vw,1.5rem)">caolepingdoris@gmail.com</a></p>

</section>
</main>

<footer>
  <p class="label">© <span id="yr"></span> Doris (Leping) Cao</p>
</footer>

<!-- ============================================================
     LIGHTBOX
     ============================================================ -->
<figure class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="x"    type="button" aria-label="Close">✕</button>
  <button class="prev" type="button" aria-label="Previous">‹</button>
  <button class="next" type="button" aria-label="Next">›</button>
  <img alt="">
  <figcaption></figcaption>
</figure>

<script>
(() => {
  "use strict";
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---- 1. apply LINKS, hide anything left empty ---------------- */
  document.querySelectorAll("[data-link]").forEach(el => {
    const url = (window.LINKS || {})[el.dataset.link] || "";
    if (!url) { el.hidden = true; el.removeAttribute("href"); return; }
    el.hidden = false;
    el.href = url;
    if (el.dataset.fill === "email") el.textContent = url.replace(/^mailto:/, "");
  });

  document.getElementById("yr").textContent = new Date().getFullYear();

  /* ---- 2. scroll progress -------------------------------------- */
  const bar = document.getElementById("progress");
  let ticking = false;
  const drawBar = () => {
    const h = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
    ticking = false;
  };
  addEventListener("scroll", () => {
    if (!ticking) { ticking = true; requestAnimationFrame(drawBar); }
  }, { passive: true });
  drawBar();

  /* ---- 3. masthead key light follows the pointer --------------- */
  const mast = document.getElementById("top");
  const key  = document.getElementById("keylight");
  if (mast && key && !reduced && matchMedia("(pointer: fine)").matches) {
    mast.addEventListener("pointermove", e => {
      const r = mast.getBoundingClientRect();
      key.style.setProperty("--lx", ((e.clientX - r.left) / r.width  * 100) + "%");
      key.style.setProperty("--ly", ((e.clientY - r.top)  / r.height * 100) + "%");
    });
  }

  /* ---- 4. carousels -------------------------------------------- */
  document.querySelectorAll(".carousel").forEach(car => {
    const track = car.querySelector(".car-track");
    const prev  = car.querySelector(".car-prev");
    const next  = car.querySelector(".car-next");
    const fill  = car.querySelector(".rail i");
    const count = car.querySelector(".count");
    const total = track.children.length;

    const page = () => {
      // one page = however many whole frames are on screen right now
      const w = track.children[0].getBoundingClientRect().width + 12;
      return Math.max(1, Math.round(track.clientWidth / w));
    };
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const per = page();
      const at  = max <= 1 ? 0 : track.scrollLeft / max;
      fill.style.transform = `scaleX(${max <= 1 ? 1 : Math.max(per / total, at * (1 - per / total) + per / total)})`;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      const first = Math.round(at * (total - per)) + 1;
      count.textContent = max <= 1
        ? String(total).padStart(2, "0")
        : `${String(first).padStart(2, "0")}–${String(Math.min(first + per - 1, total)).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
    };
    const go = d => {
      const w = track.children[0].getBoundingClientRect().width + 12;
      track.scrollBy({ left: d * w * page(), behavior: reduced ? "auto" : "smooth" });
    };
    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
    addEventListener("resize", sync);
    sync();
  });

  /* ---- 5. credits filter + pagination ---------------------------- */
  const credits = [...document.querySelectorAll("#credit-list .credit")];
  const dcounts = { all: credits.length };
  credits.forEach(c => { dcounts[c.dataset.dept] = (dcounts[c.dataset.dept] || 0) + 1; });
  document.querySelectorAll("[data-deptcount]").forEach(n => {
    n.textContent = String(dcounts[n.dataset.deptcount] || 0).padStart(2, "0");
  });

  const PAGE_SIZE = 6;
  const pager = document.getElementById("cred-pager");
  const pPrev = pager.querySelector(".cred-prev");
  const pNext = pager.querySelector(".cred-next");
  const pLbl  = pager.querySelector(".cred-page");
  let dept = "all", page = 0;

  function renderCredits() {
    const shown = credits.filter(c => dept === "all" || c.dataset.dept === dept);
    const pages = Math.max(1, Math.ceil(shown.length / PAGE_SIZE));
    page = Math.min(page, pages - 1);
    credits.forEach(c => { c.hidden = true; });
    shown.slice(page * PAGE_SIZE, page * PAGE_SIZE + PAGE_SIZE).forEach(c => { c.hidden = false; });
    pLbl.textContent = `${String(page + 1).padStart(2, "0")} / ${String(pages).padStart(2, "0")}`;
    pPrev.disabled = page === 0;
    pNext.disabled = page >= pages - 1;
    pager.hidden = pages <= 1;
  }
  pPrev.addEventListener("click", () => { page--; renderCredits(); });
  pNext.addEventListener("click", () => { page++; renderCredits(); });

  document.querySelectorAll(".chip[data-dept]").forEach(btn =>
    btn.addEventListener("click", () => {
      dept = btn.dataset.dept;
      page = 0;
      document.querySelectorAll(".chip[data-dept]").forEach(b =>
        b.setAttribute("aria-pressed", String(b === btn)));
      renderCredits();
    }));
  renderCredits();

  /* ---- 6. lightbox --------------------------------------------- */
  const lb   = document.getElementById("lb");
  const lbIm = lb.querySelector("img");
  const lbCp = lb.querySelector("figcaption");
  let list = [], idx = 0, opener = null;

  function paint() {
    const cell = list[idx];
    const img  = cell.querySelector("img");
    lbIm.src = img.src.replace("/thumb/", "/full/");
    lbIm.alt = img.alt;
    lbCp.textContent = list.length > 1
      ? `${cell.dataset.cap || img.alt}  ·  ${idx + 1} / ${list.length}`
      : (cell.dataset.cap || img.alt);
  }
  function open(cell) {
    list = [...cell.closest("[data-gallery]").querySelectorAll(".cell")].filter(c => !c.hidden);
    idx  = list.indexOf(cell);
    opener = cell;
    lb.classList.add("on");
    document.body.style.overflow = "hidden";
    lb.querySelector(".prev").hidden = lb.querySelector(".next").hidden = list.length < 2;
    paint();
    lb.querySelector(".x").focus();
  }
  function close() {
    lb.classList.remove("on");
    document.body.style.overflow = "";
    if (opener) opener.focus();
  }
  const step = d => { idx = (idx + d + list.length) % list.length; paint(); };

  document.querySelectorAll("[data-gallery]").forEach(g =>
    g.addEventListener("click", e => {
      const cell = e.target.closest(".cell");
      if (cell) open(cell);
    }));
  lb.querySelector(".x").addEventListener("click", close);
  lb.querySelector(".prev").addEventListener("click", () => step(-1));
  lb.querySelector(".next").addEventListener("click", () => step(1));
  lb.addEventListener("click", e => { if (e.target === lb || e.target === lbIm) close(); });
  addEventListener("keydown", e => {
    if (!lb.classList.contains("on")) return;
    if (e.key === "Escape")     close();
    if (e.key === "ArrowLeft")  step(-1);
    if (e.key === "ArrowRight") step(1);
  });

  /* ---- 7. reveal on scroll & nav highlight --------------------- */
  if (!reduced && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es, o) => es.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add("in"); o.unobserve(e.target); }
    }), { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".rise").forEach(el => io.observe(el));
  } else {
    document.querySelectorAll(".rise").forEach(el => el.classList.add("in"));
  }

  const navLinks = [...document.querySelectorAll(".nav a.n")];
  const spy = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return;
    navLinks.forEach(a =>
      a.setAttribute("aria-current", String(a.getAttribute("href") === "#" + e.target.id)));
  }), { rootMargin: "-45% 0px -50% 0px" });
  document.querySelectorAll("main section[id]").forEach(s => spy.observe(s));
})();
</script>
